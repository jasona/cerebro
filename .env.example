# MCP OAuth (resource-server side). Unset = OAuth off: no protected-resource
# metadata, JWT bearer tokens refused. Set to the chosen authorization server's
# issuer identifier (exact `iss`); no server has been chosen yet.
# CEREBRO_OAUTH_ISSUER=
# Optional: JWKS URL. Default: discovered from the issuer's
# /.well-known/oauth-authorization-server or openid-configuration metadata.
# CEREBRO_OAUTH_JWKS_URL=

# Dev connection tokens (cbr_…) are refused when NODE_ENV=production unless
# this dev-only escape hatch is set. Never set it in a real deployment.
# CEREBRO_ALLOW_DEV_CONNECTION_TOKENS=1
=======
# Source object storage (original upload bytes). Unset or "local" stores files
# under .data/objects (override with CEREBRO_OBJECTS_DIR). "s3" uses any
# S3-compatible service; no provider is assumed, so endpoint, region and bucket
# are required. The bucket must be private: Cerebro never sets ACLs and serves
# bytes only through authorized domain services. Startup fails fast if "s3" is
# selected but misconfigured.
# CEREBRO_OBJECT_STORE=local
# CEREBRO_OBJECTS_DIR=.data/objects
# CEREBRO_OBJECT_STORE=s3
# CEREBRO_S3_ENDPOINT=https://s3.example.internal
# CEREBRO_S3_REGION=
# CEREBRO_S3_BUCKET=
# CEREBRO_S3_FORCE_PATH_STYLE=false   # true for most self-hosted services
# CEREBRO_S3_PREFIX=                  # optional key prefix, e.g. cerebro/sources
# CEREBRO_S3_SSE=                     # optional: AES256 or aws:kms
# CEREBRO_S3_SSE_KMS_KEY_ID=          # optional, only with CEREBRO_S3_SSE=aws:kms
# Credentials use the standard variables; when unset the SDK's default
# credential chain applies (for example a workload role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
