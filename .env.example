# Leave DATABASE_URL unset to use embedded PGlite (.data/pglite).
# DATABASE_URL=postgres://cerebro:cerebro@localhost:5432/cerebro

# Web identity (D08). `dev` enables the seeded-user picker and is refused when
# NODE_ENV=production (no override). `clerk` uses Clerk; production without
# AUTH_MODE also uses Clerk.
AUTH_MODE=dev
# SESSION_SECRET=replace-with-at-least-32-random-characters

# Clerk (AUTH_MODE=clerk). Keys come from the Clerk dashboard; none are set here.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Canonical base URL. Also defines the MCP OAuth resource (APP_URL + /api/mcp),
# which access tokens must carry as their audience. Required in production.
APP_URL=http://localhost:3000

# MCP OAuth (resource-server side). Unset = OAuth off: no protected-resource
# metadata, JWT bearer tokens refused. Set to the chosen authorization server's
# issuer identifier (exact `iss`); no server has been chosen yet.
# CEREBRO_OAUTH_ISSUER=
# Optional: JWKS URL. Default: discovered from the issuer's
# /.well-known/oauth-authorization-server or openid-configuration metadata.
# CEREBRO_OAUTH_JWKS_URL=

# Dev connection tokens (cbr_…) are refused when NODE_ENV=production unless
# this dev-only escape hatch is set. Never set it in a real deployment.
# CEREBRO_ALLOW_DEV_CONNECTION_TOKENS=1
