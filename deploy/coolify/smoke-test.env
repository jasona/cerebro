# CI smoke test only (.github/workflows/ci.yml, job "images"). Dummy but
# well-formed values: nothing here is a real credential. Production gating is
# unchanged (NODE_ENV=production, AUTH_MODE=clerk): the smoke test checks
# /api/health and /api/ready, which do not use Clerk, and stores, backs up and
# restores a source object through the in-stack SeaweedFS service (`objects`)
# with its default settings (bucket cerebro-sources at http://objects:8333).
SERVICE_PASSWORD_POSTGRES=smokepostgrespassword
SERVICE_PASSWORD_CEREBRODB=smokeownerpassword
SERVICE_PASSWORD_64_SESSION=smoke-session-secret-0123456789abcdef0123456789abcdef
SERVICE_PASSWORD_64_PSEUDONYM=smoke-pseudonym-secret-0123456789abcdef0123456789abcd
SERVICE_PASSWORD_READINESS=smokereadinesstoken
SERVICE_USER_S3=smokes3user
SERVICE_PASSWORD_S3=smokes3password0123456789
SERVICE_PASSWORD_64_OBJECTSJWT=smoke-objects-jwt-0123456789abcdef0123456789abcdef0123456
APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_c21va2UuZXhhbXBsZSQ
CLERK_SECRET_KEY=sk_test_smoke
