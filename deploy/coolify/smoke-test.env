SERVICE_PASSWORD_64_PSEUDONYM=smoke-pseudonym-secret-0123456789abcdef0123456789abcd
SERVICE_PASSWORD_READINESS=smokereadinesstoken
APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_c21va2UuZXhhbXBsZSQ
CLERK_SECRET_KEY=sk_test_smoke
CEREBRO_S3_ENDPOINT=http://object-store.invalid:9000
CEREBRO_S3_REGION=smoke-region
CEREBRO_S3_BUCKET=cerebro-smoke
CEREBRO_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=smoke
AWS_SECRET_ACCESS_KEY=smoke
