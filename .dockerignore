# Build context for deploy/docker/*.Dockerfile (repository root).
# Installed and generated files are rebuilt inside the image.
**/node_modules
**/.next
.data
coverage
test-results
playwright-report
*.tsbuildinfo
# Secrets and local settings never enter an image.
.env
.env.*
!.env.example
# Not needed to build or run.
.git
.github
.claude
e2e
llm-docs
branding
deploy/coolify
